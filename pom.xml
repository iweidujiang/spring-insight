<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.iweidujiang</groupId>
    <artifactId>spring-insight-parent</artifactId>
    <!--
      版本策略（Agent / Server 分线）：
      - agent.version：业务侧 insight-agent + starter（Maven Central）；无埋点变更不升、不发
      - server.version：insight-server + 本 reactor 父 POM（GHCR / Release jar）；可随 UI 频繁升
      - 父 POM <version> 须与 server.version 保持一致
      - Agent 子模块显式 <version> 须与 agent.version 保持一致
    -->
    <version>0.4.0</version>

    <packaging>pom</packaging>
    <name>Spring Insight</name>
    <description>面向 Spring Boot 微服务的轻量监测：业务侧 agent-starter + 独立 insight-server</description>
    <url>https://github.com/iweidujiang/spring-insight</url>
    <inceptionYear>2026</inceptionYear>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>iweidujiang</id>
            <name>苏渡苇</name>
            <url>https://github.com/iweidujiang</url>
            <roles>
                <role>owner</role>
                <role>developer</role>
            </roles>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/iweidujiang/spring-insight.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/iweidujiang/spring-insight.git</developerConnection>
        <url>https://github.com/iweidujiang/spring-insight</url>
        <tag>HEAD</tag>
    </scm>

    <issueManagement>
        <system>GitHub</system>
        <url>https://github.com/iweidujiang/spring-insight/issues</url>
    </issueManagement>

    <modules>
        <module>insight-agent</module>
        <module>insight-server</module>
        <module>spring-insight-agent-starter</module>
    </modules>

    <properties>
        <!-- Agent：与 Central 已发版对齐；有埋点变更再 bump 并 deploy -->
        <agent.version>0.3.2</agent.version>
        <!-- Server / 父 POM：可随控制台发版独立 bump（GHCR） -->
        <server.version>0.4.0</server.version>

        <!-- Agent + Server 统一目标 Java 17（Boot 3 基线；JDK 21+ 亦可运行） -->
        <java.version>17</java.version>
        <spring-boot.version>3.5.9</spring-boot.version>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <lombok.version>1.18.30</lombok.version>
        <maven-source-plugin.version>3.3.1</maven-source-plugin.version>
        <maven-javadoc-plugin.version>3.11.2</maven-javadoc-plugin.version>
        <maven-gpg-plugin.version>3.2.7</maven-gpg-plugin.version>
        <central-publishing-maven-plugin.version>0.11.0</central-publishing-maven-plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>io.github.iweidujiang</groupId>
                <artifactId>insight-agent</artifactId>
                <version>${agent.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.iweidujiang</groupId>
                <artifactId>spring-insight-agent-starter</artifactId>
                <version>${agent.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.iweidujiang</groupId>
                <artifactId>insight-server</artifactId>
                <version>${server.version}</version>
            </dependency>

            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
                <scope>provided</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.11.0</version>
                    <configuration>
                        <release>${java.version}</release>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-enforcer-plugin</artifactId>
                    <version>3.5.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-source-plugin</artifactId>
                    <version>${maven-source-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <version>${maven-javadoc-plugin.version}</version>
                    <configuration>
                        <release>${java.version}</release>
                        <encoding>UTF-8</encoding>
                        <charset>UTF-8</charset>
                        <docencoding>UTF-8</docencoding>
                        <!-- 首发以可发布为准；后续再收紧 doclint -->
                        <doclint>none</doclint>
                        <failOnError>true</failOnError>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-gpg-plugin</artifactId>
                    <version>${maven-gpg-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.sonatype.central</groupId>
                    <artifactId>central-publishing-maven-plugin</artifactId>
                    <version>${central-publishing-maven-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <!-- 构建与运行基线：JDK 17+（交叉编译目标亦为 17） -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-java-17</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <phase>validate</phase>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[17,)</version>
                                    <message>
【Spring Insight】请用 JDK 17+ 运行 Maven。
Agent 与 insight-server 字节码目标均为 Java 17（Spring Boot 3 基线；JDK 21+ 亦可运行）。
                                    </message>
                                </requireJavaVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <!--
      发布到 Maven Central（仅 Agent 有变更时）：
        1) 同步 bump properties.agent.version 与 insight-agent / starter 的 <version>
        2) ~/.m2/settings.xml 配置 server id=central 的 Portal Token
        3) 本机 GPG 可用（可用 -Dgpg.skip=true 仅验证 sources/javadoc）
        4) 只 deploy Agent 模块，避免把 Server 推上 Central：
           mvn -Prelease clean deploy -pl insight-agent,spring-insight-agent-starter -am "-Dskip.ui=true"
        Server 发版：改 server.version（= 父 POM version）后打 v* tag → GHCR / Release jar
      日常开发不要开 -Prelease，以免每次签名。
    -->
    <profiles>
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                                <configuration>
                                    <!-- CI/无密钥：-Dgpg.skip=true；正式 deploy 勿跳过 -->
                                    <!-- 勿默认 loopback：Windows 上无 gpg.passphrase 时会一直挂起等 stdin。
                                         本地用 Kleopatra/pinentry 弹窗即可；CI 可加：
                                         -Dgpg.passphrase=... 且另配 loopback -->
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <!-- 首次建议网页确认后再 Publish；熟悉后可改 true -->
                            <autoPublish>false</autoPublish>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
