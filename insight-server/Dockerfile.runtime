# 本地开发：本机先 mvn package，再只打运行镜像（不在容器里拉 Maven 依赖）
#   mvn -pl insight-server -am package -DskipTests
#   docker build -f insight-server/Dockerfile.runtime -t spring-insight-server:local .
ARG JRE_IMAGE=eclipse-temurin:17-jre-alpine
FROM ${JRE_IMAGE}
WORKDIR /app

RUN apk add --no-cache curl

LABEL org.opencontainers.image.title="Spring Insight Server" \
      org.opencontainers.image.description="轻量监测中心（本地预构建 jar）" \
      org.opencontainers.image.source="https://github.com/iweidujiang/spring-insight" \
      org.opencontainers.image.licenses="Apache-2.0"

COPY insight-server/target/insight-server.jar app.jar

EXPOSE 9966

ENV JAVA_OPTS="" \
    SPRING_INSIGHT_SERVER_STORAGE_FILE_PATH=/data/spans.json \
    SPRING_INSIGHT_SERVER_STORAGE_SQLITE_PATH=/data/insight.db

HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
  CMD curl -fsS http://127.0.0.1:9966/api/v1/health >/dev/null || exit 1

ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -jar /app/app.jar"]
