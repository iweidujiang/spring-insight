# 复制为 .env 后按本机填写（.env 勿提交）。配合：
#   docker compose -f compose.dev.yaml --env-file .env up -d --build

INSIGHT_HOST_PORT=9966
INSIGHT_STORAGE_MODE=sqlite

# 安全（compose 默认全开）
INSIGHT_INGEST_REQUIRED=true
INSIGHT_INGEST_TOKEN=change-me
INSIGHT_UI_AUTH_ENABLED=true
INSIGHT_UI_USERNAME=admin
INSIGHT_UI_PASSWORD=change-me

# 告警 Webhook：指向 demo 自带收件箱（钉钉式 POST），不要用 webhook.site
# Boot3 sca-demo（网关默认 8080；直连 order 则用 ORDER_HOST_PORT 如 8081）：
INSIGHT_ALERT_ENABLED=true
INSIGHT_ALERT_WEBHOOK_URL=http://host.docker.internal:8080/insight-alert/webhook
# Boot2 联调时改为：
# INSIGHT_ALERT_WEBHOOK_URL=http://host.docker.internal:18090/insight-alert/webhook
INSIGHT_ALERT_METRIC=error_count
INSIGHT_ALERT_THRESHOLD=1
INSIGHT_ALERT_WINDOW_MINUTES=15
INSIGHT_ALERT_COOLDOWN_MINUTES=2

# 告警邮件（真实邮箱示例：QQ 邮箱 SMTP）
# 1) QQ 邮箱 → 设置 → 账户 → 开启 SMTP，生成「授权码」填到 PASSWORD
# 2) 465+SSL：PORT=465、START_TLS=false、SSL=true
# 3) 587+STARTTLS：PORT=587、START_TLS=true、SSL=false（下面默认）
INSIGHT_ALERT_EMAIL_ENABLED=true
INSIGHT_ALERT_EMAIL_HOST=smtp.qq.com
INSIGHT_ALERT_EMAIL_PORT=587
INSIGHT_ALERT_EMAIL_USERNAME=你的QQ号@qq.com
INSIGHT_ALERT_EMAIL_PASSWORD=邮箱授权码
INSIGHT_ALERT_EMAIL_FROM=你的QQ号@qq.com
INSIGHT_ALERT_EMAIL_TO=你的QQ号@qq.com
INSIGHT_ALERT_EMAIL_START_TLS=true
INSIGHT_ALERT_EMAIL_SSL=false

# AI（OpenAI 兼容；DeepSeek 示例如下）
INSIGHT_AI_ENABLED=true
INSIGHT_AI_PROVIDER=openai-compatible
# OpenAI: https://api.openai.com/v1 + gpt-4o-mini
# DeepSeek:
INSIGHT_AI_BASE_URL=https://api.deepseek.com/v1
INSIGHT_AI_API_KEY=
INSIGHT_AI_MODEL=deepseek-chat
INSIGHT_AI_TIMEOUT_MS=30000
INSIGHT_AI_MAX_INPUT_SPANS=40
INSIGHT_AI_MAX_TOKENS=800
