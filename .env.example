# 可选。复制为 .env 后按需修改（.env 勿提交）。
# 告警 / AI / 鉴权请在控制台「设置」页配置，不必写在这里。

INSIGHT_HOST_PORT=9966
INSIGHT_STORAGE_MODE=sqlite
# INSIGHT_RETENTION_HOURS=0

# 覆盖官方 Compose 拉取的镜像（默认与最新发版一致）
# INSIGHT_SERVER_IMAGE=ghcr.io/iweidujiang/spring-insight-server:1.2.0

# 控制台登录。compose.dev.yaml 默认开启，账号 admin / 1
# 官方 compose.yaml 默认关闭；若要用登录可取消下面注释：
# INSIGHT_UI_AUTH_ENABLED=true
# INSIGHT_UI_USERNAME=admin
# INSIGHT_UI_PASSWORD=1
